---
import { meta, about } from "../content";

const specs = [
  { key: "based", value: "Southern California" },
  { key: "focus", value: "Full-stack systems" },
  { key: "role", value: "AI SWE @ Internet Brands" },
];
---

<!-- The intro is plain HTML. src/scripts/hero-build.ts plays the wave and the
     crew on top of it, using the two canvases and the hero-building class. -->
<div class="hero-stage" id="hero-stage">
  <canvas class="hero-water" aria-hidden="true"></canvas>

  <section class="site-container hero" aria-label="Introduction">
    <button class="hero-skip" type="button" aria-label="Skip the intro animation">skip build →</button>

    <div class="hero-text">
      <p class="hero-eyebrow mono-label">
        Software Engineer
      </p>
      <h1 class="hero-name" data-text={meta.name}>{meta.name}</h1>

      <dl class="hero-specs">
        {specs.map((s) => (
          <div class="hero-spec-row">
            <dt class="hero-spec-key">{s.key}</dt>
            <dd class="hero-spec-val">{s.value}</dd>
          </div>
        ))}
      </dl>

      <div class="hero-actions">
        <a href={meta.resumePath} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Resume
        </a>
        <a href={meta.linkedin} target="_blank" rel="noopener noreferrer" class="hero-link">
          LinkedIn
        </a>
        <a href={meta.github} target="_blank" rel="noopener noreferrer" class="hero-link">
          GitHub
        </a>
      </div>
    </div>

    <div class="hero-headshot-wrapper">
      <div class="hero-headshot-frame">
        <img
          src={meta.headshotPath}
          alt={meta.name}
          class="hero-headshot"
          width="240"
          height="300"
        />
      </div>
    </div>
  </section>

  <canvas class="hero-crew" aria-hidden="true"></canvas>
</div>
